# ==============================================================================
# SMART INVOICE CHASING - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to Git or expose service-role / private API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Public)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
# Project URL (Format: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Public Anon API Key (Safe for browser / client-side components)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_KEY

# ------------------------------------------------------------------------------
# 2. Supabase Server Configuration (Private / Server-Only)
# Obtain from: Project Settings > API > Project API Keys > service_role
# ------------------------------------------------------------------------------
# Service-Role Key: Required for server-side dispatch operations, collection event
# audits, and background webhook writes that bypass RLS.
# CRITICAL: NEVER prefix with NEXT_PUBLIC_ or expose to the browser!
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------------------------
# 3. Application Site URL
# ------------------------------------------------------------------------------
# Base URL used for OAuth redirects and email callback links.
# In local development: http://localhost:3000
# In production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Resend Outbound Email Dispatch (Private / Server-Only)
# Obtain from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
# Resend API Key (Begins with "re_")
RESEND_API_KEY=re_your_resend_api_key

# Verified Sender Address (Must match a domain verified in Resend > Domains)
# Example: Smart Invoice Chasing <billing@yourverifieddomain.com>
RESEND_FROM_EMAIL=Smart Invoice Chasing <verified-sender@yourdomain.com>

# ------------------------------------------------------------------------------
# 5. Resend Webhook Delivery Tracking (Private / Server-Only)
# Obtain from: https://resend.com/webhooks > Signing Secret
# ------------------------------------------------------------------------------
# Webhook Signing Secret (Begins with "whsec_")
# Used by /api/webhooks/resend to verify Svix HMAC-SHA256 delivery signatures.
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
