# ==============================================================================
# SMART INVOICE CHASING — LOCAL STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Safe template for local Supabase Docker integration testing.
# Copy this file to .env.staging when running local integration tests.
# NEVER commit .env.staging or enter production credentials here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Supabase Client Configuration (Default Local CLI Ports)
# ------------------------------------------------------------------------------
# Default local API gateway: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local anon key (Output by `npx supabase start` or `npx supabase status`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-staging-anon-key-placeholder

# ------------------------------------------------------------------------------
# 2. Local Supabase Server Configuration (Local Service Role Key)
# ------------------------------------------------------------------------------
# Local service role key (Output by `npx supabase start` or `npx supabase status`)
# NEVER use production service-role credentials in local testing!
SUPABASE_SERVICE_ROLE_KEY=local-staging-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 3. Application Site URL & Environment Flags
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local_staging
SUPABASE_LOCAL_MODE=true

# ------------------------------------------------------------------------------
# 4. Outbound Messaging Mock Isolation (NO Real Dispatch in Staging)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_mock_disabled_in_staging
RESEND_FROM_EMAIL=Smart Invoice Chasing Staging <staging@smartchasing.test>
RESEND_WEBHOOK_SECRET=whsec_staging_mock_signing_secret
